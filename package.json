    "test:phase3": "vitest run tests/phase3 tests/security/phase3-routes.test.ts",
    "test:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/browser/phase3-browser-smoke.ps1",
    "test:payments": "vitest run tests/payments",
    "test:security": "vitest run tests/security",
    "test:notifications": "vitest run tests/notifications",
    "test:promos": "vitest run tests/promos",
    "test:media": "vitest run tests/media",
    "test:analytics": "vitest run tests/analytics",
    "test:admin-tools": "vitest run tests/admin-tools tests/notifications/admin-route.test.ts",
    "test:accessibility": "vitest run tests/accessibility",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@mux/upchunk": "^3.5.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
