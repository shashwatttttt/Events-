    "hls.js": "^1.6.16",
    "html5-qrcode": "^2.3.8",
    "next": "16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.1.0",
    "stripe": "^18.5.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.23",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
