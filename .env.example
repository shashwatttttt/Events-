# APPLICATION
APP_MODE=test
DATA_PROVIDER=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=SKIE EVENTS
APP_TIMEZONE=Australia/Melbourne
APP_CURRENCY=AUD
DEFAULT_TICKET_LIMIT=2
DEFAULT_ALLOCATION_EXPIRY_HOURS=48

# SESSION / LOCAL TEST MODE
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@skieevents.com
ADMIN_PASSWORD=replace-this-before-sharing-the-local-build

# SUPABASE (required when DATA_PROVIDER=supabase or APP_MODE=live)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# STRIPE (required for live payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# POST-CHECKOUT APPROVAL (keep disabled until staging and controlled live tests pass)
POST_CHECKOUT_APPROVAL_ENABLED=false
# Short completion target shown to customers. The legacy FORM_MINUTES value remains a fallback.
POST_CHECKOUT_CUSTOMER_URGENCY_MINUTES=60
POST_CHECKOUT_FORM_MINUTES=60
# Real server-side form availability. Stripe capture_before remains the absolute payment limit.
POST_CHECKOUT_ACTUAL_FORM_HOURS=120
POST_CHECKOUT_REVIEW_HOURS=24
POST_CHECKOUT_CAPTURE_SAFETY_MINUTES=60
POST_CHECKOUT_WORKER_SECRET=replace-with-a-separate-32-character-secret

# META ADS (Pixel ID is public; keep the Conversions API token server-side only)
NEXT_PUBLIC_META_PIXEL_ID=1738508524058416
META_CONVERSIONS_API_ENABLED=false
META_CONVERSIONS_API_TOKEN=
# Use the Graph API version shown by Meta when generating the direct integration token, e.g. vXX.X.
META_GRAPH_API_VERSION=
# Temporary code from Events Manager > Test events. Remove after production verification.
META_TEST_EVENT_CODE=
META_ADS_CONSENT_VERSION=2026-07-30

# RESEND (required for live email)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_PROVIDER=local
EMAIL_FROM=SKIE EVENTS <tickets@skieevents.com>
EMAIL_REPLY_TO=hello@skieevents.com

# TRANSACTIONAL NOTIFICATIONS (use test/staging provider credentials only)
NOTIFICATION_WORKER_SECRET=replace-with-a-separate-32-character-secret
NOTIFICATION_DEFAULT_COUNTRY=AU
SMS_PROVIDER=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
WHATSAPP_NOTIFICATIONS_ENABLED=false
TWILIO_WHATSAPP_FROM=

# VIDEO PROCESSING (Mux test/staging credentials only)
MEDIA_VIDEO_PROVIDER=local
MEDIA_VIDEO_ALLOWED_INPUT_TYPES=video/mp4,video/quicktime,video/webm
MEDIA_VIDEO_MAX_UPLOAD_BYTES=5368709120
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_DEFAULT_PLAYBACK_POLICY=public
MUX_POSTER_DEFAULT_TIME_SECONDS=1

# SECURITY / OPTIONAL
TICKET_TOKEN_SECRET=replace-with-a-separate-32-character-secret
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
